Bootstrap: docker
From: ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# EquiFlex training/inference image for the 'dream' slurm cluster
# (singularity-ce 3.10, A100-40GB x8 nodes, driver 575 / CUDA 12.9).
#
# Dependencies only. The repository is NOT baked in: bind it at /work and the
# image imports equiflex from /work/src (PYTHONPATH below), so code edits need an
# rsync, not a rebuild. The environment is exactly uv.lock (uv sync --frozen):
# the same torch 2.8.0+cu128, cuequivariance 0.7.0 and PyG wheels as the local
# .venv. requires-python is ==3.12.*, so the base image carries CPython 3.12
# and uv; Debian bookworm's own python is not used.
#
# cu128 wheels need a driver reporting CUDA >= 12.8; dream reports 12.9.
# A cu13 torch would abort with "NVIDIA driver on your system is too old".
#
# Build (network, fakeroot, ~15 GB of scratch in APPTAINER_TMPDIR):
#   apptainer build --fakeroot equiflex.sif scripts/dream/equiflex.def
#
# Run (repo bound at /work, 4 GPUs):
#   singularity exec --nv -B /scratch:/scratch -B $PWD:/work --pwd /work equiflex.sif \
#       torchrun --standalone --nproc_per_node=4 scripts/train.py --config configs/dream_smoke.yaml

%files
    pyproject.toml              /opt/equiflex-lock/pyproject.toml
    uv.lock                     /opt/equiflex-lock/uv.lock
    README.md                   /opt/equiflex-lock/README.md
    LICENSE                     /opt/equiflex-lock/LICENSE
    scripts/patch_unimol.sh     /opt/equiflex-lock/scripts/patch_unimol.sh
    scripts/unimol_padding.patch /opt/equiflex-lock/scripts/unimol_padding.patch

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # git: muon-optimizer and normuon are git sources in uv.lock.
    # patch: scripts/patch_unimol.sh. gcc/g++/libc6-dev: triton JIT-compiles
    # kernels at run time (torch.compile, cuequivariance), not at build time.
    # libgomp1/libstdc++6: what the torch wheels link against.
    # libxrender1/libxext6/libsm6/libgl1: rdkit.Chem.Draw, imported by
    # unimol_tools on import.
    apt-get install -y --no-install-recommends \
        git patch gcc g++ libc6-dev libgomp1 libstdc++6 ca-certificates \
        libxrender1 libxext6 libsm6 libgl1
    rm -rf /var/lib/apt/lists/*

    export UV_PROJECT_ENVIRONMENT=/opt/venv
    export UV_PYTHON=/usr/local/bin/python3.12
    export UV_LINK_MODE=copy
    export UV_CACHE_DIR=/tmp/uv-cache
    export UV_NO_PROGRESS=1
    # --no-install-project: dependencies only, the repo comes in at /work.
    cd /opt/equiflex-lock
    uv sync --frozen --no-dev --no-install-project
    rm -rf /tmp/uv-cache

    # Uni-Mol padding-invariance patch; UniMolExtractor refuses to run without it.
    PYTHON=/opt/venv/bin/python bash scripts/patch_unimol.sh

    /opt/venv/bin/python - <<'PY'
import torch, pytorch_lightning, cuequivariance_torch, torch_scatter, pyg_lib, unimol_tools, esm
assert torch.__version__.startswith("2.8.0+cu128"), torch.__version__
print("torch", torch.__version__, "lightning", pytorch_lightning.__version__)
PY
    mkdir -p /work

%environment
    export PATH=/opt/venv/bin:$PATH
    export VIRTUAL_ENV=/opt/venv
    # Repo bound at /work (override with EQUIFLEX_ROOT=/path when bound elsewhere).
    export PYTHONPATH=${EQUIFLEX_ROOT:-/work}/src${PYTHONPATH:+:$PYTHONPATH}
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-8}
    # JIT caches must not land inside the read-only image.
    export TRITON_CACHE_DIR=${TRITON_CACHE_DIR:-/tmp/triton_cache}
    export NUMBA_CACHE_DIR=${NUMBA_CACHE_DIR:-/tmp/numba_cache}
    export MPLCONFIGDIR=${MPLCONFIGDIR:-/tmp/mpl_config}

%runscript
    exec python "$@"

%test
    # unimol_tools creates ./logs on import; the image root is read-only.
    cd /tmp
    /opt/venv/bin/python -c "import torch, pytorch_lightning, cuequivariance_torch; print('torch', torch.__version__)"
    /opt/venv/bin/torchrun --help > /dev/null && echo "torchrun ok"
    /opt/venv/bin/python -c "from unimol_tools.models import transformersv2; assert transformersv2.PADDING_INVARIANT; print('unimol patched')"

%labels
    Description EquiFlex dependencies (uv.lock), repo bind-mounted at /work
    Python      3.12
    CUDA        torch 2.8.0+cu128, runs on drivers reporting CUDA 12.8 or newer
